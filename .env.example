# Microsoft Foundry project used by the discovery agent (planner = "auto" or "foundry").
# Authentication uses DefaultAzureCredential (for example: az login).
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<model-deployment-name>

# Optional: require "Authorization: Bearer <token>" on every API call.
# DDG_API_TOKEN=
